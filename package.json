  "main": "src/main.js",
  "author": "EasyCraft Launcher",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "prepare:build": "node scripts/write-build-info.js",
    "dist:win": "npm run prepare:build && electron-builder --win nsis",
    "dist:portable": "npm run prepare:build && electron-builder --win portable"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "minecraft-java-core": "4.2.9"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.easycraft.launcher",
    "productName": "EasyCraft Launcher",
    "asar": true,
    "asarUnpack": [
      "node_modules/minecraft-java-core/**",
      "node_modules/7zip-bin/**"
    ],
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "EasyCraft-Launcher-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EasyCraft Launcher"
    }
  }
}
